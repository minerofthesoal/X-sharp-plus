    "terminal.ansiGreen": "#98c379",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBlue": "#61afef",
    "terminal.ansiMagenta": "#c678dd",
    "terminal.ansiCyan": "#56b6c2",
    "terminal.ansiWhite": "#e0e0e0",
    "terminal.ansiBrightBlack": "#5c6370",
    "terminal.ansiBrightRed": "#ff8787",
    "terminal.ansiBrightGreen": "#b5e8a0",
    "terminal.ansiBrightYellow": "#f0d89c",
    "terminal.ansiBrightBlue": "#8ec8f4",
    "terminal.ansiBrightMagenta": "#d9a0ec",
    "terminal.ansiBrightCyan": "#7fd4de",
    "terminal.ansiBrightWhite": "#ffffff",

    "input.background": "#1a1a2e",
    "input.foreground": "#e0e0e0",
