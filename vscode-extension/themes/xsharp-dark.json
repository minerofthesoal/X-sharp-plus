    "editorSuggestWidget.highlightForeground": "#61afef",
    "editorSuggestWidget.selectedBackground": "#2a2a4a",

    "notificationCenterHeader.background": "#1a1a2e",
    "notifications.background": "#1a1a2e",
    "notifications.border": "#3d3d6b"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#5c6370",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Control flow keywords",
      "scope": [
        "keyword.control.xsharp"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.double",
        "string.quoted.single"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.section.interpolation.begin",
        "punctuation.section.interpolation.end"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Types",
      "scope": [
        "support.type.primitive",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Class/Entity names",
      "scope": [
        "entity.name.type.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#61afef",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "entity.name.function.call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#e5c07b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.pipe",
        "keyword.operator.power",
        "keyword.operator.arrow",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "name": "Self keyword",
      "scope": [
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d19a66",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.braces",
        "punctuation.section.brackets",
        "punctuation.section.parens"
      ],
      "settings": {
        "foreground": "#abb2bf"
      }
    },
    {
      "name": "Import/summon source",
      "scope": [
        "keyword.other.xsharp"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Main entry keyword",
      "scope": [
        "keyword.declaration.function.main"
      ],
      "settings": {
        "foreground": "#ff6b6b",
        "fontStyle": "bold"
      }
    }
  ]
}
